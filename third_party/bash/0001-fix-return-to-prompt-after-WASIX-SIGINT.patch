From 96c397adbbc5cf32351649733f4ef91f89cfcf70 Mon Sep 17 00:00:00 2001
From: Corey Weir <corey.weir852@gmail.com>
Date: Fri, 14 Aug 2026 08:56:40 +1000
Subject: [PATCH 1/3] fix: return to prompt after WASIX SIGINT

---
 nojobs.c | 30 ++++++++++++++++++++++++------
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/nojobs.c b/nojobs.c
index b904512..ca74f90 100644
--- a/nojobs.c
+++ b/nojobs.c
@@ -811,7 +811,13 @@ wait_sigint_handler (
       SIGRETURN (0);
     }
 
-  wait_sigint_received = 1;
+  if (interactive_shell)
+    {
+      if (interrupt_state == 0)
+	ADDINTERRUPT;
+    }
+  else
+    wait_sigint_received = 1;
 
   SIGRETURN (0);
 }
@@ -857,15 +863,14 @@ wait_for (
       return (pstatus);
     }
 
-  /* If we are running a script, ignore SIGINT while we're waiting for
-     a child to exit.  The loop below does some of this, but not all. */
+  /* Keep SIGINT inside Bash while waiting. On WASIX, leaving the interactive
+     handler installed can allow libc's default callback to abort the shell. */
   wait_sigint_received = 0;
-  if (interactive_shell == 0)
-    old_sigint_handler = set_signal_handler (SIGINT, wait_sigint_handler);
+  old_sigint_handler = set_signal_handler (SIGINT, wait_sigint_handler);
 
   waiting_for_child = 1;  
   CHECK_WAIT_INTR;
-  while ((got_pid = WAITPID (-1, &status, 0)) != pid) /* XXX was pid now -1 */
+  while ((got_pid = WAITPID (pid, &status, 0)) != pid)
     {
       waiting_for_child = 0;
       CHECK_TERMSIG;
@@ -919,6 +924,19 @@ wait_for (
 	    }
 	}
     }
+  else
+    restore_sigint_handler ();
+
+  /* WASIX reports a child killed by SIGINT as a normal 128+SIGINT exit.
+     Avoid longjmp across the resumed proc_join stack; let loop execution
+     return normally to the interactive reader instead. */
+  if (process_exit_status (status) == 128+SIGINT)
+    {
+      if (loop_level)
+	breaking = loop_level;
+    }
+  else
+    QUIT;
 
   /* Default return value. */
   /* ``a full 8 bits of status is returned'' */
