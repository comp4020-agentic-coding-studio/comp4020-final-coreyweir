--- /dev/null
+++ b/wasix-compat/unistd.h
@@ -0,0 +1,8 @@
+#ifndef _WASIX_COMPAT_UNISTD_H
+#define _WASIX_COMPAT_UNISTD_H
+#include_next <unistd.h>
+#ifndef __WASIX_FORK_DECLARED
+#define __WASIX_FORK_DECLARED
+pid_t fork(void);
+#endif
+#endif
--- /dev/null
+++ b/wasix-compat/proc.c
@@ -0,0 +1,13 @@
+#include <wasi/api.h>
+typedef int pid_t;
+extern int errno;
+
+pid_t fork(void) {
+  __wasi_pid_t pid;
+  __wasi_errno_t err = __wasi_proc_fork((__wasi_bool_t)1, &pid);
+  if (err != __WASI_ERRNO_SUCCESS) {
+    errno = err;
+    return -1;
+  }
+  return (pid_t)pid;
+}
